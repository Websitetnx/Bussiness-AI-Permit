# Base URL of the existing PHP project (no /api suffix).
# Android emulator: use 10.0.2.2 instead of localhost.
# Physical device: use your computer's LAN IP, with Apache reachable over Wi-Fi.
EXPO_PUBLIC_API_URL=http://10.0.2.2/git%20test/Business-Management-main%20-%20Copy
# Local development only. Production builds must use HTTPS and set this to false.
EXPO_PUBLIC_ALLOW_HTTP=true

# Copy to .env and fill in your local values. Never commit the real .env.
# Server/process variables take precedence. Legacy config.local.php overrides both.
# One KEY=value per line. Quote values containing spaces or #.
# Inside quotes, escape backslashes and the matching quote with a backslash.
# Values are literal: no variable expansion, commands, or multiline values.

APP_URL=
APP_TIMEZONE=Asia/Manila
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=permitflow
DB_USER=root
DB_PASS=
ADMIN_SETUP_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
SMTP_AUTH=true
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=PERMIT
DOCUMENT_ALERT_ADMIN_EMAIL=
DOCUMENT_ALERT_ADMIN_NAME='PERMIT Administrator'
MAIL_TIMEOUT_SECONDS=15

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
ALLOW_SENSITIVE_AI_SCAN=false
AI_DAILY_SCAN_LIMIT=100
AI_INSIGHT_COOLDOWN_SECONDS=60

OTP_EXPIRY_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Optional encrypted backup CLI settings (password must be at least 16 characters).
BACKUP_PASSWORD=
# RESTORE_DB_NAME=permit_restore_drill
# RESTORE_DB_USER=
# RESTORE_DB_PASS=
